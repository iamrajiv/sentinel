{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI-powered Engineering Codex guardrail agent on Cloudflare Workers.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "evals": "tsx evals/run.ts",
    "evals:live": "tsx evals/run.ts --live",
    "cf-typegen": "wrangler types",
    "test:watch": "vitest --config vitest.config.ts",
    "evals:record": "tsx evals/run.ts --record",
    "evals:replay": "tsx evals/run.ts --replay",
    "dev:ai": "SENTINEL_REMOTE_AI=1 vite dev"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "agents": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
